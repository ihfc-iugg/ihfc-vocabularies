    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/cRTD"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/other"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/unspecified"/>
    <skos:prefLabel xml:lang="en">Temperature determination method</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://heatflow.world/vocabularies/temperature-method/DTSeq">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Distributed Temperature Sensing (DTS) in equilibrium conditions.</skos:definition>
    <skos:inScheme rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
    <skos:prefLabel xml:lang="en">DTSeq</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://heatflow.world/vocabularies/temperature-method/XEN">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Temperature estimates from xenoliths.</skos:definition>
    <skos:inScheme rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
    <skos:prefLabel xml:lang="en">XEN</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://heatflow.world/vocabularies/temperature-method/LOGpert">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Continuous temperature logging in a perturbed borehole using semiconductor transducer or thermistor probe.</skos:definition>
    <skos:inScheme rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
    <skos:prefLabel xml:lang="en">LOGpert</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://heatflow.world/vocabularies/temperature-method/cBHT">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Bottom Hole Temperature, corrected for perturbations.</skos:definition>
    <skos:inScheme rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
    <skos:prefLabel xml:lang="en">cBHT</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://heatflow.world/vocabularies/temperature-method/other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Other temperature determination method (must be specified in comments).</skos:definition>
    <skos:inScheme rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://heatflow.world/vocabularies/temperature-method/EGRT">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
    <skos:prefLabel xml:lang="en">EGRT</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://heatflow.world/vocabularies/temperature-method/cLOG">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Continuous temperature logging in a perturbed borehole, corrected for perturbations.</skos:definition>
    <skos:inScheme rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
    <skos:prefLabel xml:lang="en">cLOG</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://heatflow.world/vocabularies/temperature-method/cRTD">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Resistance Temperature Detector (RTD) measurement in perturbed conditions, corrected for perturbations.</skos:definition>
    <skos:inScheme rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
    <skos:prefLabel xml:lang="en">cRTD</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://heatflow.world/vocabularies/temperature-method/CPD">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Curie Point/Depth temperature estimates.</skos:definition>
    <skos:inScheme rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
    <skos:prefLabel xml:lang="en">CPD</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://heatflow.world/vocabularies/temperature-method/HT_FTpert">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">High-temperature fluid-temperature measurement in perturbed conditions.</skos:definition>
    <skos:inScheme rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
    <skos:prefLabel xml:lang="en">HT-FTpert</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://heatflow.world/vocabularies/temperature-method/HT_FT">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">High-temperature fluid-temperature measurement in equilibrium conditions.</skos:definition>
    <skos:inScheme rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
    <skos:prefLabel xml:lang="en">HT-FTeq</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://heatflow.world/vocabularies/temperature-method/BSR">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Temperature estimates from bottom-simulating seismic reflector.</skos:definition>
