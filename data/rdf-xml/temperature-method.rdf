    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Continuous temperature logging in borehole equilibrium using semiconductor transducer or thermistor probe.</skos:definition>
    <skos:inScheme rdf:resource="https://heatflow.world/vocabularies/temperature-method"/>
    <skos:prefLabel xml:lang="en">LOGeq</skos:prefLabel>
