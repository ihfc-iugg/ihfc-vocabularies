    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/LOGpert"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/ODTT_PC"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/ODTT_TP"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/RTDeq"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/RTDpert"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/SUR"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/XEN"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/cBHT"/>
