  <rdf:Description rdf:about="https://heatflow.world/vocabularies/temperature-method">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:definition xml:lang="en">Methods used to determine temperature for the purpose of deriving heat flow.</skos:definition>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/BHT"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/BLK"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/BSR"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/CPD"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/DTSeq"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/DTSpert"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/EGRT"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/GRT"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/GTM"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/HT_FT"/>
    <skos:hasTopConcept rdf:resource="https://heatflow.world/vocabularies/temperature-method/HT_FTpert"/>
