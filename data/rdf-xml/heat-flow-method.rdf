<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://portal.heatflow.world/vocabularies/heat-flow-method/numerical">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method"/>
    <skos:prefLabel xml:lang="en">Other numerical computations</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.heatflow.world/vocabularies/heat-flow-method">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:description xml:lang="en">Methods used to determine a heat-flow value from temperature and thermal conductivity data.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method/bootstrap"/>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method/bullard"/>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method/interval"/>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method/numerical"/>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method/other"/>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method/unspecified"/>
    <skos:prefLabel xml:lang="en">Heat-flow methods</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.heatflow.world/vocabularies/heat-flow-method/other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Specify the method in comments</skos:definition>
    <skos:inScheme rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.heatflow.world/vocabularies/heat-flow-method/bullard">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Heat-flow value given as the angular coefficient of the linear regression of the thermal resistance vs. temperature data (used when there is a significant variation of thermal conductivity within the depth range over which the temperatures have been measured)</skos:definition>
    <skos:inScheme rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method"/>
    <skos:prefLabel xml:lang="en">Bullard method</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.heatflow.world/vocabularies/heat-flow-method/unspecified">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method"/>
    <skos:prefLabel xml:lang="en">Unspecified</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.heatflow.world/vocabularies/heat-flow-method/bootstrap">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Iterative procedure aimed at minimize the difference between the measured and modelled temperatures by solving the 1-D steady-state conductive geotherm (radiogenic heat production of rocks is accounted for)</skos:definition>
    <skos:inScheme rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method"/>
    <skos:prefLabel xml:lang="en">Boot-strapping method</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.heatflow.world/vocabularies/heat-flow-method/interval">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Product of the mean thermal gradient to the mean thermal conductivity with reference to a specified depth interval</skos:definition>
    <skos:inScheme rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method"/>
    <skos:prefLabel xml:lang="en">Interval method</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://portal.heatflow.world/vocabularies/heat-flow-method"/>
  </rdf:Description>
</rdf:RDF>
