<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://portal.heatflow.world/vocabularies/conductivity-location">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:description xml:lang="en">Where the thermal conductivity used for a heat-flow value was measured, relative to the heat-flow site.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/conductivity-location/actual"/>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/conductivity-location/literature"/>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/conductivity-location/other"/>
    <skos:prefLabel xml:lang="en">Thermal conductivity location</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.heatflow.world/vocabularies/conductivity-location/literature">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://portal.heatflow.world/vocabularies/conductivity-location"/>
    <skos:prefLabel xml:lang="en">Literature-unspecified</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://portal.heatflow.world/vocabularies/conductivity-location"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.heatflow.world/vocabularies/conductivity-location/actual">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://portal.heatflow.world/vocabularies/conductivity-location"/>
    <skos:prefLabel xml:lang="en">Actual heat-flow location</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://portal.heatflow.world/vocabularies/conductivity-location"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.heatflow.world/vocabularies/conductivity-location/other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://portal.heatflow.world/vocabularies/conductivity-location"/>
    <skos:prefLabel xml:lang="en">Other location</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://portal.heatflow.world/vocabularies/conductivity-location"/>
  </rdf:Description>
</rdf:RDF>
