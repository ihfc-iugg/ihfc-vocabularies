  <rdf:Description rdf:about="https://portal.heatflow.world/vocabularies/temperature-corrections">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dcterms:description xml:lang="en">Methods used to correct measured temperatures for disturbances, such as those caused by drilling, before heat flow is derived.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/temperature-corrections/aapg"/>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/temperature-corrections/cylinderSource"/>
