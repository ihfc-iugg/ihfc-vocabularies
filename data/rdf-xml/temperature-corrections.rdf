    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/temperature-corrections/inverseNM"/>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/temperature-corrections/lineSourceExplosion"/>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/temperature-corrections/not_corrected"/>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/temperature-corrections/other"/>
    <skos:hasTopConcept rdf:resource="https://portal.heatflow.world/vocabularies/temperature-corrections/unspecified"/>
    <skos:prefLabel xml:lang="en">Temperature correction methods</skos:prefLabel>
  </rdf:Description>
