PREFIX : <https://portal.heatflow.world/vocabularies/heat-flow-corrections/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX ihfc: <https://portal.heatflow.world/vocabularies/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

:generic
    a skos:Collection ;
    skos:definition "Generic flag choices for heat flow data"@en ;
    skos:member
        :not_recognized ,
        :present_corrected ,
        :present_not_corrected ,
        :present_not_significant ,
        :unspecified ;
    skos:prefLabel "Generic"@en ;
.

:insitu
    a skos:Collection ;
    skos:definition "In-situ measurements"@en ;
    skos:member
        :consideredP ,
        :consideredPT ,
        :consideredT ,
        :notConsidered ,
        :unspecified ;
    skos:prefLabel "In-situ"@en ;
.

:temperature
    a skos:Collection ;
    skos:definition "Temperature measurements"@en ;
    skos:member
        :corrected ,
        :driftCorrected ,
        :notCorrected ,
        :tiltCorrected ,
        :unspecified ;
    skos:prefLabel "Temperature"@en ;
.

<https://doi.org/10.1016/j.tecto.2023.229976>
    a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Fuchs, S., Norden, B., Neumann, F., Kaul, N., Tanaka, A., Kukkonen, I. T., et al. (2023). Quality-assurance of heat-flow data: The new structure and evaluation scheme of the IHFC Global Heat Flow Database. Tectonophysics, 863, 229976."@en ;
.

<https://doi.org/10.31214/ijthfa.v4i1.62>
    a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Fuchs, S., Beardsmore, G., Chiozzi, P., Espinoza-Ojeda, O. M., Gola, G., Gosnold, W., Harris, R., Jennings, S., Liu, S., Negrete-Aranda, R., Neumann, F., Norden, B., Poort, J., Rajver, D., Ray, L., Richards, M., Smith, J., Tanaka, A., and Verdoya, M. (2021). A new database structure for the IHFC Global Heat Flow Database. International Journal of Terrestrial Heat Flow and Applied Geothermics, 4(1), 1–14."@en ;
.

<https://doi.org/10.5880/fidgeo.2026.065>
    a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Jennings, Samuel; Neumann, Florian; Norden, Ben; Balkan-Pazvantoğlu, Elif; Elbarbary, Samah; Petrunin, Alexey G.; Elger, Kirsten; Fuchs, Sven (2026): IHFC Controlled Vocabularies for the Global Heat Flow Database. GFZ Data Services. https://doi.org/10.5880/fidgeo.2026.065"@en ;
    dcterms:title "IHFC Controlled Vocabularies for the Global Heat Flow Database"@en ;
.

<https://ror.org/04z8jg394>
    a foaf:Organization ;
    foaf:homepage <https://www.gfz.de/en/> ;
    foaf:name "GFZ Helmholtz Centre for Geosciences"@en ;
.

<https://ihfc-iugg.org/>
    a foaf:Organization ;
    foaf:homepage <https://ihfc-iugg.org/> ;
    foaf:name "International Heat Flow Commission"@en ;
.

:consideredP
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-corrections ;
    skos:prefLabel "Considered - p"@en ;
    skos:topConceptOf ihfc:heat-flow-corrections ;
.

:consideredPT
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-corrections ;
    skos:prefLabel "Considered - pT"@en ;
    skos:topConceptOf ihfc:heat-flow-corrections ;
.

:consideredT
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-corrections ;
    skos:prefLabel "Considered - t"@en ;
    skos:topConceptOf ihfc:heat-flow-corrections ;
.

:corrected
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-corrections ;
    skos:prefLabel "Corrected"@en ;
    skos:topConceptOf ihfc:heat-flow-corrections ;
.

:driftCorrected
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-corrections ;
    skos:prefLabel "Drift corrected"@en ;
    skos:topConceptOf ihfc:heat-flow-corrections ;
.

:notConsidered
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-corrections ;
    skos:prefLabel "not considered"@en ;
    skos:topConceptOf ihfc:heat-flow-corrections ;
.

:notCorrected
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-corrections ;
    skos:prefLabel "not corrected"@en ;
    skos:topConceptOf ihfc:heat-flow-corrections ;
.

:not_recognized
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-corrections ;
    skos:prefLabel "not recognized"@en ;
    skos:topConceptOf ihfc:heat-flow-corrections ;
.

:present_corrected
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-corrections ;
    skos:prefLabel "Present and corrected"@en ;
    skos:topConceptOf ihfc:heat-flow-corrections ;
.

:present_not_corrected
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-corrections ;
    skos:prefLabel "Present and not corrected"@en ;
    skos:topConceptOf ihfc:heat-flow-corrections ;
.

:present_not_significant
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-corrections ;
    skos:prefLabel "Present not significant"@en ;
    skos:topConceptOf ihfc:heat-flow-corrections ;
.

:tiltCorrected
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-corrections ;
    skos:prefLabel "Tilt corrected"@en ;
    skos:topConceptOf ihfc:heat-flow-corrections ;
.

:unspecified
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-corrections ;
    skos:prefLabel "unspecified"@en ;
    skos:topConceptOf ihfc:heat-flow-corrections ;
.

ihfc:heat-flow-corrections
    a skos:ConceptScheme ;
    dcterms:creator <https://ihfc-iugg.org/> ;
    dcterms:description "Flags recording whether an effect that can bias heat-flow data was present, and whether it was considered or corrected."@en ;
    dcterms:isPartOf <https://doi.org/10.5880/fidgeo.2026.065> ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://ror.org/04z8jg394> ;
    dcterms:source
        <https://doi.org/10.1016/j.tecto.2023.229976> ,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    rdfs:seeAlso <https://github.com/ihfc-iugg/ihfc-vocabularies> ;
    skos:hasTopConcept
        :consideredP ,
        :consideredPT ,
        :consideredT ,
        :corrected ,
        :driftCorrected ,
        :notConsidered ,
        :notCorrected ,
        :not_recognized ,
        :present_corrected ,
        :present_not_corrected ,
        :present_not_significant ,
        :tiltCorrected ,
        :unspecified ;
    skos:prefLabel "Correction flags"@en ;
    skos:scopeNote "Lists the values allowed in the fields corr_IS_flag, corr_T_flag, corr_S_flag, corr_E_flag, corr_TOPO_flag, corr_PAL_flag, corr_SUR_flag, corr_CONV_flag and corr_HR_flag of the Global Heat Flow Database."@en ;
.
