PREFIX : <https://portal.heatflow.world/vocabularies/conductivity-strategy/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ihfc: <https://portal.heatflow.world/vocabularies/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

:characterize
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-strategy ;
    skos:prefLabel "Characterize formation conductivities"@en ;
    skos:topConceptOf ihfc:conductivity-strategy ;
.

:computation
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-strategy ;
    skos:prefLabel "Computation from probe sensing"@en ;
    skos:topConceptOf ihfc:conductivity-strategy ;
.

:other
    a skos:Concept ;
    skos:definition "Other"@en ;
    skos:inScheme ihfc:conductivity-strategy ;
    skos:prefLabel "Other"@en ;
    skos:topConceptOf ihfc:conductivity-strategy ;
.

:random
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-strategy ;
    skos:prefLabel "Random or periodic depth sampling"@en ;
    skos:topConceptOf ihfc:conductivity-strategy ;
.

:unspecified
    a skos:Concept ;
    skos:definition "Unspecified"@en ;
    skos:inScheme ihfc:conductivity-strategy ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:conductivity-strategy ;
.

:well_log
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-strategy ;
    skos:prefLabel "Well log interpretation"@en ;
    skos:topConceptOf ihfc:conductivity-strategy ;
.

ihfc:conductivity-strategy
    a skos:ConceptScheme ;
    dcterms:description "The strategy used to obtain thermal conductivity values for the depth interval of a heat-flow determination."@en ;
    skos:hasTopConcept
        :characterize ,
        :computation ,
        :other ,
        :random ,
        :unspecified ,
        :well_log ;
    skos:prefLabel "Thermal conductivity strategies"@en ;
.
