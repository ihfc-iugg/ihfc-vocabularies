PREFIX : <https://portal.heatflow.world/vocabularies/conductivity-location/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ihfc: <https://portal.heatflow.world/vocabularies/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

:actual
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-location ;
    skos:prefLabel "Actual heat-flow location"@en ;
    skos:topConceptOf ihfc:conductivity-location ;
.

:literature
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-location ;
    skos:prefLabel "Literature-unspecified"@en ;
    skos:topConceptOf ihfc:conductivity-location ;
.

:other
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-location ;
    skos:prefLabel "Other location"@en ;
    skos:topConceptOf ihfc:conductivity-location ;
.

ihfc:conductivity-location
    a skos:ConceptScheme ;
    dcterms:description "Where the thermal conductivity used for a heat-flow value was measured, relative to the heat-flow site."@en ;
    skos:hasTopConcept
        :actual ,
        :literature ,
        :other ;
    skos:prefLabel "Thermal conductivity location"@en ;
.
