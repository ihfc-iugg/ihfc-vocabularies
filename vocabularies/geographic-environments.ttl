PREFIX : <https://portal.heatflow.world/vocabularies/geographic-environments/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ihfc: <https://portal.heatflow.world/vocabularies/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

:offshore
    a skos:Collection ;
    skos:definition "Geographic environments found offshore."@en ;
    skos:member
        :offshore_continental ,
        :offshore_marine ;
    skos:prefLabel "Offshore environments"@en ;
.

:onshore
    a skos:Collection ;
    skos:definition "Geographic environments found onshore."@en ;
    skos:member
        :onshore_continental ,
        :onshore_marine ;
    skos:prefLabel "Onshore environments"@en ;
.

:unspecified
    a skos:Concept ;
    skos:inScheme ihfc:geographic-environments ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:geographic-environments ;
.

:offshore_continental
    a skos:Concept ;
    skos:inScheme ihfc:geographic-environments ;
    skos:prefLabel "Offshore (continental)"@en ;
    skos:topConceptOf ihfc:geographic-environments ;
.

:offshore_marine
    a skos:Concept ;
    skos:definition "An offshore marine environment refers to the part of the ocean that is beyond the coastal zone, typically starting from the edge of the continental shelf and extending into the open ocean. It includes deep-sea regions, open waters, and underwater ecosystems such as seamounts, mid-ocean ridges, and abyssal plains."@en ;
    skos:inScheme ihfc:geographic-environments ;
    skos:prefLabel "Offshore (marine)"@en ;
    skos:topConceptOf ihfc:geographic-environments ;
.

:onshore_continental
    a skos:Concept ;
    skos:inScheme ihfc:geographic-environments ;
    skos:prefLabel "Onshore (continental)"@en ;
    skos:topConceptOf ihfc:geographic-environments ;
.

:onshore_marine
    a skos:Concept ;
    skos:inScheme ihfc:geographic-environments ;
    skos:prefLabel "Onshore (lake-river-etc.)"@en ;
    skos:topConceptOf ihfc:geographic-environments ;
.

ihfc:geographic-environments
    a skos:ConceptScheme ;
    dcterms:description "The basic geographic environment in which a heat-flow measurement was made, onshore or offshore."@en ;
    skos:hasTopConcept
        :offshore_continental ,
        :offshore_marine ,
        :onshore_continental ,
        :onshore_marine ,
        :unspecified ;
    skos:prefLabel "Geographic environments"@en ;
.
