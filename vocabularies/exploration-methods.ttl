PREFIX : <https://portal.heatflow.world/vocabularies/exploration-methods/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ihfc: <https://portal.heatflow.world/vocabularies/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

:drilling
    a skos:Concept ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Drilling"@en ;
    skos:topConceptOf ihfc:exploration-methods ;
.

:drilling_clustering
    a skos:Concept ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Drilling-Clustering"@en ;
    skos:topConceptOf ihfc:exploration-methods ;
.

:indirect
    a skos:Concept ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Indirect (GTM-BSR-CPD-etc.)"@en ;
    skos:topConceptOf ihfc:exploration-methods ;
.

:mining
    a skos:Concept ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Mining"@en ;
    skos:topConceptOf ihfc:exploration-methods ;
.

:other
    a skos:Concept ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Other"@en ;
    skos:topConceptOf ihfc:exploration-methods ;
.

:probing_clustering
    a skos:Concept ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Probing-Clustering"@en ;
    skos:topConceptOf ihfc:exploration-methods ;
.

:probing_offshore
    a skos:Concept ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Probing (offshore-ocean)"@en ;
    skos:topConceptOf ihfc:exploration-methods ;
.

:probing_onshore
    a skos:Concept ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Probing (onshore-lake-river-etc.)"@en ;
    skos:topConceptOf ihfc:exploration-methods ;
.

:tunneling
    a skos:Concept ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Tunneling"@en ;
    skos:topConceptOf ihfc:exploration-methods ;
.

:unspecified
    a skos:Concept ;
    skos:inScheme ihfc:exploration-methods ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:exploration-methods ;
.

ihfc:exploration-methods
    a skos:ConceptScheme ;
    dcterms:description "The general means by which temperature sensors gained access to the rock, such as drilling, probing, mining or tunnelling."@en ;
    skos:hasTopConcept
        :drilling ,
        :drilling_clustering ,
        :indirect ,
        :mining ,
        :other ,
        :probing_clustering ,
        :probing_offshore ,
        :probing_onshore ,
        :tunneling ,
        :unspecified ;
    skos:prefLabel "Exploration methods"@en ;
.
