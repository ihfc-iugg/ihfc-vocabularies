    a skos:Concept ;
    skos:inScheme <https://portal.heatflow.world/vocabularies/exploration-methods> ;
    skos:prefLabel "Probing-Clustering"@en ;
    skos:topConceptOf <https://portal.heatflow.world/vocabularies/exploration-methods> ;
.

ghfdb:probing_offshore
    a skos:Concept ;
    skos:inScheme <https://portal.heatflow.world/vocabularies/exploration-methods> ;
    skos:prefLabel "Probing (offshore-ocean)"@en ;
    skos:topConceptOf <https://portal.heatflow.world/vocabularies/exploration-methods> ;
