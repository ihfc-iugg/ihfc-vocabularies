PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ghfdb: <https://portal.heatflow.world/vocabularies/exploration-methods/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

ghfdb:drilling
    a skos:Concept ;
    skos:inScheme <https://portal.heatflow.world/vocabularies/exploration-methods> ;
    skos:prefLabel "Drilling"@en ;
    skos:topConceptOf <https://portal.heatflow.world/vocabularies/exploration-methods> ;
.

ghfdb:drilling_clustering
    a skos:Concept ;
    skos:inScheme <https://portal.heatflow.world/vocabularies/exploration-methods> ;
    skos:prefLabel "Drilling-Clustering"@en ;
    skos:topConceptOf <https://portal.heatflow.world/vocabularies/exploration-methods> ;
.

ghfdb:indirect
    a skos:Concept ;
    skos:inScheme <https://portal.heatflow.world/vocabularies/exploration-methods> ;
    skos:prefLabel "Indirect (GTM-BSR-CPD-etc.)"@en ;
    skos:topConceptOf <https://portal.heatflow.world/vocabularies/exploration-methods> ;
.

ghfdb:mining
    a skos:Concept ;
    skos:inScheme <https://portal.heatflow.world/vocabularies/exploration-methods> ;
