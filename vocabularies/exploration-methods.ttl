ghfdb:unspecified
    a skos:Concept ;
    skos:inScheme <https://portal.heatflow.world/vocabularies/exploration-methods> ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf <https://portal.heatflow.world/vocabularies/exploration-methods> ;
.

<https://portal.heatflow.world/vocabularies/exploration-methods>
    a skos:ConceptScheme ;
    dcterms:description "The general means by which temperature sensors gained access to the rock, such as drilling, probing, mining or tunnelling."@en ;
    skos:hasTopConcept
        ghfdb:drilling ,
        ghfdb:drilling_clustering ,
        ghfdb:indirect ,
        ghfdb:mining ,
        ghfdb:other ,
        ghfdb:probing_clustering ,
        ghfdb:probing_offshore ,
        ghfdb:probing_onshore ,
        ghfdb:tunneling ,
        ghfdb:unspecified ;
    skos:prefLabel "Exploration methods"@en ;
.
