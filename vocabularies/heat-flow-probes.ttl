PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ghfdb: <https://portal.heatflow.world/vocabularies/heat-flow-probes/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

ghfdb:other
    a skos:Concept ;
    skos:inScheme <https://portal.heatflow.world/vocabularies/heat-flow-probes> ;
    skos:prefLabel "Other (specify in comments)"@en ;
    skos:topConceptOf <https://portal.heatflow.world/vocabularies/heat-flow-probes> ;
.

