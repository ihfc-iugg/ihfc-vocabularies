PREFIX : <https://portal.heatflow.world/vocabularies/heat-flow-probes/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ihfc: <https://portal.heatflow.world/vocabularies/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

:other
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-probes ;
    skos:prefLabel "Other (specify in comments)"@en ;
    skos:topConceptOf ihfc:heat-flow-probes ;
.

:outrigger_autonomous_no_corer
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-probes ;
    skos:prefLabel "Outrigger probe (autonomous) without corer"@en ;
    skos:topConceptOf ihfc:heat-flow-probes ;
.

:outrigger_autonomous_with_corer
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-probes ;
    skos:prefLabel "Outrigger probe (autonomous) with corer"@en ;
    skos:topConceptOf ihfc:heat-flow-probes ;
.

:outrigger_ewing
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-probes ;
    skos:prefLabel "Outrigger probe (Ewing) with corer"@en ;
    skos:topConceptOf ihfc:heat-flow-probes ;
.

:outrigger_haenel
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-probes ;
    skos:prefLabel "Outrigger probe (Haenel) in-situ TC"@en ;
    skos:topConceptOf ihfc:heat-flow-probes ;
.

:outrigger_hybrid_lister_hylo
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-probes ;
    skos:prefLabel "Outrigger probe (Hybrid Lister) HyLO"@en ;
    skos:topConceptOf ihfc:heat-flow-probes ;
.

:outrigger_lister
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-probes ;
    skos:prefLabel "Outrigger probe (Lister) with corer"@en ;
    skos:topConceptOf ihfc:heat-flow-probes ;
.

:outrigger_von_herzen
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-probes ;
    skos:prefLabel "Outrigger probe (Von Herzen) in-situ TC"@en ;
    skos:topConceptOf ihfc:heat-flow-probes ;
.

:single_steel
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-probes ;
    skos:prefLabel "Single Steel probe (Bullard)"@en ;
    skos:topConceptOf ihfc:heat-flow-probes ;
.

:single_steel_insituTC
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-probes ;
    skos:prefLabel "Single Steel probe (Bullard) in-situ TC"@en ;
    skos:topConceptOf ihfc:heat-flow-probes ;
.

:submersible
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-probes ;
    skos:prefLabel "Submersible probe"@en ;
    skos:topConceptOf ihfc:heat-flow-probes ;
.

:unspecified
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-probes ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:heat-flow-probes ;
.

:violin_bow
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-probes ;
    skos:prefLabel "Violin-Bow probe (Lister)"@en ;
    skos:topConceptOf ihfc:heat-flow-probes ;
.

ihfc:heat-flow-probes
    a skos:ConceptScheme ;
    dcterms:description "Types of probe used to measure heat flow, mainly in marine settings."@en ;
    skos:hasTopConcept
        :other ,
        :outrigger_autonomous_no_corer ,
        :outrigger_autonomous_with_corer ,
        :outrigger_ewing ,
        :outrigger_haenel ,
        :outrigger_hybrid_lister_hylo ,
        :outrigger_lister ,
        :outrigger_von_herzen ,
        :single_steel ,
        :single_steel_insituTC ,
        :submersible ,
        :unspecified ,
        :violin_bow ;
    skos:prefLabel "Heat-flow probe types"@en ;
.
