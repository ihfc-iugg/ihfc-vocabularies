<https://portal.heatflow.world/vocabularies/heat-flow-probes>
    a skos:ConceptScheme ;
    dcterms:description "Types of probe used to measure heat flow, mainly in marine settings."@en ;
    skos:hasTopConcept
        ghfdb:other ,
        ghfdb:outrigger_autonomous_no_corer ,
        ghfdb:outrigger_autonomous_with_corer ,
        ghfdb:outrigger_ewing ,
        ghfdb:outrigger_haenel ,
        ghfdb:outrigger_hybrid_lister_hylo ,
        ghfdb:outrigger_lister ,
        ghfdb:outrigger_von_herzen ,
        ghfdb:single_steel ,
        ghfdb:single_steel_insituTC ,
        ghfdb:submersible ,
        ghfdb:unspecified ,
        ghfdb:violin_bow ;
    skos:prefLabel "Heat-flow probe types"@en ;
.
