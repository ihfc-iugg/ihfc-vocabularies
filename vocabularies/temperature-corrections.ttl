PREFIX : <https://portal.heatflow.world/vocabularies/temperature-corrections/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ihfc: <https://portal.heatflow.world/vocabularies/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

:aapg
    a skos:Concept ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "AAPG correction"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

:cylinderSource
    a skos:Concept ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "Cylinder source method"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

:hornerPlot
    a skos:Concept ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "Horner plot"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

:inverseNM
    a skos:Concept ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "Inverse numerical modelling"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

:lineSourceExplosion
    a skos:Concept ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "Line source explosion method"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

:not_corrected
    a skos:Concept ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "not corrected"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

:other
    a skos:Concept ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "Other published correction"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

:unspecified
    a skos:Concept ;
    skos:inScheme ihfc:temperature-corrections ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:temperature-corrections ;
.

ihfc:temperature-corrections
    a skos:ConceptScheme ;
    dcterms:description "Methods used to correct measured temperatures for disturbances, such as those caused by drilling, before heat flow is derived."@en ;
    skos:hasTopConcept
        :aapg ,
        :cylinderSource ,
        :hornerPlot ,
        :inverseNM ,
        :lineSourceExplosion ,
        :not_corrected ,
        :other ,
        :unspecified ;
    skos:prefLabel "Temperature correction methods"@en ;
.
