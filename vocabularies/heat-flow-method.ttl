PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX ihfc: <https://portal.heatflow.world/vocabularies/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

<https://doi.org/10.1016/j.tecto.2023.229976>
    a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Fuchs, S., Norden, B., Neumann, F., Kaul, N., Tanaka, A., Kukkonen, I. T., et al. (2023). Quality-assurance of heat-flow data: The new structure and evaluation scheme of the IHFC Global Heat Flow Database. Tectonophysics, 863, 229976."@en ;
.

<https://doi.org/10.31214/ijthfa.v4i1.62>
    a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Fuchs, S., Beardsmore, G., Chiozzi, P., Espinoza-Ojeda, O. M., Gola, G., Gosnold, W., Harris, R., Jennings, S., Liu, S., Negrete-Aranda, R., Neumann, F., Norden, B., Poort, J., Rajver, D., Ray, L., Richards, M., Smith, J., Tanaka, A., and Verdoya, M. (2021). A new database structure for the IHFC Global Heat Flow Database. International Journal of Terrestrial Heat Flow and Applied Geothermics, 4(1), 1–14."@en ;
.

<https://doi.org/10.5880/fidgeo.2026.065>
    a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Jennings, Samuel; Neumann, Florian; Norden, Ben; Balkan-Pazvantoğlu, Elif; Elbarbary, Samah; Petrunin, Alexey G.; Elger, Kirsten; Fuchs, Sven (2026): IHFC Controlled Vocabularies for the Global Heat Flow Database. GFZ Data Services. https://doi.org/10.5880/fidgeo.2026.065"@en ;
    dcterms:title "IHFC Controlled Vocabularies for the Global Heat Flow Database"@en ;
.

:bootstrap
    a skos:Concept ;
    skos:definition "Iterative procedure aimed at minimize the difference between the measured and modelled temperatures by solving the 1-D steady-state conductive geotherm (radiogenic heat production of rocks is accounted for)"@en ;
    skos:inScheme ihfc:heat-flow-method ;
    skos:prefLabel "Boot-strapping method"@en ;
    skos:topConceptOf ihfc:heat-flow-method ;
.

:bullard
    a skos:Concept ;
    skos:definition "Heat-flow value given as the angular coefficient of the linear regression of the thermal resistance vs. temperature data (used when there is a significant variation of thermal conductivity within the depth range over which the temperatures have been measured)"@en ;
    skos:inScheme ihfc:heat-flow-method ;
    skos:prefLabel "Bullard method"@en ;
    skos:topConceptOf ihfc:heat-flow-method ;
.

:interval
    a skos:Concept ;
    skos:definition "Product of the mean thermal gradient to the mean thermal conductivity with reference to a specified depth interval"@en ;
    skos:inScheme ihfc:heat-flow-method ;
    skos:prefLabel "Interval method"@en ;
    skos:topConceptOf ihfc:heat-flow-method ;
.

:numerical
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-method ;
    skos:prefLabel "Other numerical computations"@en ;
    skos:topConceptOf ihfc:heat-flow-method ;
.

:other
    a skos:Concept ;
    skos:definition "Specify the method in comments"@en ;
    skos:inScheme ihfc:heat-flow-method ;
    skos:prefLabel "Other"@en ;
    skos:topConceptOf ihfc:heat-flow-method ;
.

:unspecified
    a skos:Concept ;
    skos:inScheme ihfc:heat-flow-method ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:heat-flow-method ;
.

<https://ror.org/04z8jg394>
    a foaf:Organization ;
    foaf:homepage <https://www.gfz.de/en/> ;
    foaf:name "GFZ Helmholtz Centre for Geosciences"@en ;
.

<https://ihfc-iugg.org/>
    a foaf:Organization ;
    foaf:homepage <https://ihfc-iugg.org/> ;
    foaf:name "International Heat Flow Commission"@en ;
.

ihfc:heat-flow-method
    a skos:ConceptScheme ;
    dcterms:creator <https://ihfc-iugg.org/> ;
    dcterms:description "Methods used to determine a heat-flow value from temperature and thermal conductivity data."@en ;
    dcterms:isPartOf <https://doi.org/10.5880/fidgeo.2026.065> ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://ror.org/04z8jg394> ;
    dcterms:source
        <https://doi.org/10.1016/j.tecto.2023.229976> ,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    rdfs:seeAlso <https://github.com/ihfc-iugg/ihfc-vocabularies> ;
    skos:hasTopConcept
        :bootstrap ,
        :bullard ,
        :interval ,
        :numerical ,
        :other ,
        :unspecified ;
    skos:prefLabel "Heat-flow methods"@en ;
    skos:scopeNote "Lists the values allowed in the field q_method of the Global Heat Flow Database."@en ;
.
