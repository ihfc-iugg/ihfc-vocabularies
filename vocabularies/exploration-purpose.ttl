ihfc:exploration-purpose
    a skos:ConceptScheme ;
    dcterms:creator <https://ihfc-iugg.org/> ;
    dcterms:description "The main purpose of the original excavation that gave temperature sensors access to the rock."@en ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://ror.org/04z8jg394> ;
    dcterms:source
        <https://doi.org/10.1016/j.tecto.2023.229976> ,
        <https://doi.org/10.31214/ijthfa.v4i1.62> ;
    rdfs:seeAlso <https://github.com/ihfc-iugg/ihfc-vocabularies> ;
    skos:hasTopConcept
        :geothermal ,
        :groundwater ,
        :hydrocarbon ,
        :mapping ,
        :mining ,
        :other ,
        :research ,
        :tunneling ,
        :underground_storage ,
        :unspecified ;
    skos:prefLabel "Exploration purposes"@en ;
    skos:scopeNote "Lists the values allowed in the field explo_purpose of the Global Heat Flow Database."@en ;
.
