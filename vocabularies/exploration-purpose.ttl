PREFIX : <https://portal.heatflow.world/vocabularies/exploration-purpose/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ihfc: <https://portal.heatflow.world/vocabularies/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

:geothermal
    a skos:Concept ;
    skos:inScheme ihfc:exploration-purpose ;
    skos:prefLabel "Geothermal"@en ;
    skos:topConceptOf ihfc:exploration-purpose ;
.

:groundwater
    a skos:Concept ;
    skos:inScheme ihfc:exploration-purpose ;
    skos:prefLabel "Groundwater"@en ;
    skos:topConceptOf ihfc:exploration-purpose ;
.

:hydrocarbon
    a skos:Concept ;
    skos:inScheme ihfc:exploration-purpose ;
    skos:prefLabel "Hydrocarbon"@en ;
    skos:topConceptOf ihfc:exploration-purpose ;
.

:mapping
    a skos:Concept ;
    skos:inScheme ihfc:exploration-purpose ;
    skos:prefLabel "Mapping"@en ;
    skos:topConceptOf ihfc:exploration-purpose ;
.

:mining
    a skos:Concept ;
    skos:inScheme ihfc:exploration-purpose ;
    skos:prefLabel "Mining"@en ;
    skos:topConceptOf ihfc:exploration-purpose ;
.

:other
    a skos:Concept ;
    skos:inScheme ihfc:exploration-purpose ;
    skos:prefLabel "Other"@en ;
    skos:topConceptOf ihfc:exploration-purpose ;
.

:research
    a skos:Concept ;
    skos:inScheme ihfc:exploration-purpose ;
    skos:prefLabel "Research"@en ;
    skos:topConceptOf ihfc:exploration-purpose ;
.

:tunneling
    a skos:Concept ;
    skos:inScheme ihfc:exploration-purpose ;
    skos:prefLabel "Tunneling"@en ;
    skos:topConceptOf ihfc:exploration-purpose ;
.

:underground_storage
    a skos:Concept ;
    skos:inScheme ihfc:exploration-purpose ;
    skos:prefLabel "Underground storage"@en ;
    skos:topConceptOf ihfc:exploration-purpose ;
.

:unspecified
    a skos:Concept ;
    skos:inScheme ihfc:exploration-purpose ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:exploration-purpose ;
.

ihfc:exploration-purpose
    a skos:ConceptScheme ;
    dcterms:description "The main purpose of the original excavation that gave temperature sensors access to the rock."@en ;
    skos:hasTopConcept
        :geothermal ,
        :groundwater ,
        :hydrocarbon ,
        :mapping ,
        :mining ,
        :other ,
        :research ,
        :tunneling ,
        :underground_storage ,
        :unspecified ;
    skos:prefLabel "Exploration purposes"@en ;
.
