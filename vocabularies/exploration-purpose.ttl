    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf <https://heatflow.world/vocabularies/exploration-purpose> ;
.

<https://heatflow.world/vocabularies/exploration-purpose>
    a skos:ConceptScheme ;
    skos:definition "Main purpose of the original excavation providing access for the temperature sensors."@en ;
    skos:hasTopConcept
        ghfdb:geothermal ,
        ghfdb:groundwater ,
        ghfdb:hydrocarbon ,
        ghfdb:mapping ,
        ghfdb:mining ,
        ghfdb:other ,
        ghfdb:research ,
        ghfdb:tunneling ,
        ghfdb:underground_storage ,
        ghfdb:unspecified ;
    skos:prefLabel "Exploration purposes"@en ;
.
