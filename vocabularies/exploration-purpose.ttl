PREFIX ghfdb: <https://heatflow.world/vocabularies/exploration-purpose/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

ghfdb:geothermal
    a skos:Concept ;
    skos:inScheme <https://heatflow.world/vocabularies/exploration-purpose> ;
    skos:prefLabel "Geothermal"@en ;
    skos:topConceptOf <https://heatflow.world/vocabularies/exploration-purpose> ;
.

ghfdb:groundwater
    a skos:Concept ;
    skos:inScheme <https://heatflow.world/vocabularies/exploration-purpose> ;
    skos:prefLabel "Groundwater"@en ;
