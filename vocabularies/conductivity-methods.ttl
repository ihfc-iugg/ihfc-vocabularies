PREFIX : <https://portal.heatflow.world/vocabularies/conductivity-methods/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ihfc: <https://portal.heatflow.world/vocabularies/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

:estimation
    a skos:Collection ;
    skos:definition "Estimation from other sources"@en ;
    skos:member
        :chlorineContent ,
        :lithology ,
        :mineralComposition ,
        :waterContent ;
    skos:prefLabel "Estimation"@en ;
.

:laboratory
    a skos:Collection ;
    skos:definition "Laboratory measurements"@en ;
    skos:member
        :laboratoryOther ,
        :lineSourceFull ,
        :lineSourceHalf ,
        :planeSourceFull ,
        :planeSourceHalf ,
        :pointSource ;
    skos:prefLabel "Laboratory"@en ;
.

:other
    a skos:Collection ;
    skos:definition "Other methods"@en ;
    skos:member :unspecified ;
    skos:prefLabel "Other"@en ;
.

:probe
    a skos:Collection ;
    skos:definition "Probe measurements"@en ;
    skos:member
        :probeContinuousHeating ,
        :probePulse ;
    skos:prefLabel "Probe"@en ;
.

:well_log
    a skos:Collection ;
    skos:definition "Well-log interpretation"@en ;
    skos:member
        :wellLogDeterministic ,
        :wellLogEmpirical ;
    skos:prefLabel "Well-log"@en ;
.

:chlorineContent
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Estimation - from chlorine content"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

:laboratoryOther
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Lab - other"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

:lineSourceFull
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Lab - line source - full space"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

:lineSourceHalf
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Lab - line source - half space"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

:lithology
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Estimation - from lithology and literature"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

:mineralComposition
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Estimation - from mineral composition"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

:planeSourceFull
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Lab - plane source - full space"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

:planeSourceHalf
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Lab - plane source - half space"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

:pointSource
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Lab - point source"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

:probeContinuousHeating
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Probe - continuous heating technique"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

:probePulse
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Probe - pulse technique"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

:unspecified
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

:waterContent
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Estimation - from water content-porosity"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

:wellLogDeterministic
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Well-log - deterministic approach"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

:wellLogEmpirical
    a skos:Concept ;
    skos:inScheme ihfc:conductivity-methods ;
    skos:prefLabel "Well-log - empirical equation"@en ;
    skos:topConceptOf ihfc:conductivity-methods ;
.

ihfc:conductivity-methods
    a skos:ConceptScheme ;
    dcterms:description "Methods used to determine thermal conductivity, by laboratory measurement, in-situ probe, well-log interpretation or estimation."@en ;
    skos:hasTopConcept
        :chlorineContent ,
        :laboratoryOther ,
        :lineSourceFull ,
        :lineSourceHalf ,
        :lithology ,
        :mineralComposition ,
        :planeSourceFull ,
        :planeSourceHalf ,
        :pointSource ,
        :probeContinuousHeating ,
        :probePulse ,
        :unspecified ,
        :waterContent ,
        :wellLogDeterministic ,
        :wellLogEmpirical ;
    skos:prefLabel "Thermal conductivity methods"@en ;
.
