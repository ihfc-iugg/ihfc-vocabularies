PREFIX : <https://portal.heatflow.world/vocabularies/temperature-method/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ihfc: <https://portal.heatflow.world/vocabularies/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

:BHT
    a skos:Concept ;
    skos:definition "Bottom Hole Temperature, uncorrected."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "BHT"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:BLK
    a skos:Concept ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "BLK"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:BSR
    a skos:Concept ;
    skos:definition "Temperature estimates from bottom-simulating seismic reflector."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "BSR"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:CPD
    a skos:Concept ;
    skos:definition "Curie Point/Depth temperature estimates."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "CPD"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:DTSeq
    a skos:Concept ;
    skos:definition "Distributed Temperature Sensing (DTS) in equilibrium conditions."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "DTSeq"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:DTSpert
    a skos:Concept ;
    skos:definition "Distributed Temperature Sensing (DTS) in perturbed conditions."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "DTSpert"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:EGRT
    a skos:Concept ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "EGRT"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:GRT
    a skos:Concept ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "GRT"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:GTM
    a skos:Concept ;
    skos:definition "Temperature estimates from geothermometry."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "GTM"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:HT_FT
    a skos:Concept ;
    skos:definition "High-temperature fluid-temperature measurement in equilibrium conditions."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "HT-FTeq"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:HT_FTpert
    a skos:Concept ;
    skos:definition "High-temperature fluid-temperature measurement in perturbed conditions."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "HT-FTpert"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:LOGeq
    a skos:Concept ;
    skos:definition "Continuous temperature logging in borehole equilibrium using semiconductor transducer or thermistor probe."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "LOGeq"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:LOGpert
    a skos:Concept ;
    skos:definition "Continuous temperature logging in a perturbed borehole using semiconductor transducer or thermistor probe."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "LOGpert"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:ODTT_PC
    a skos:Concept ;
    skos:definition "Ocean Drilling Temperature Tool - piston corer."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "ODTT-PC"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:ODTT_TP
    a skos:Concept ;
    skos:definition "Ocean Drilling Temperature Tool - thermistor probe."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "ODTT-TP"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:RTDeq
    a skos:Concept ;
    skos:definition "Resistance Temperature Detector (RTD) measurement in equilibrium conditions."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "RTDeq"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:RTDpert
    a skos:Concept ;
    skos:definition "Resistance Temperature Detector (RTD) measurement in perturbed conditions."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "RTDpert"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:SUR
    a skos:Concept ;
    skos:definition "Surface temperature or bottom water temperature measurement."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "SUR"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:XEN
    a skos:Concept ;
    skos:definition "Temperature estimates from xenoliths."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "XEN"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:cBHT
    a skos:Concept ;
    skos:definition "Bottom Hole Temperature, corrected for perturbations."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "cBHT"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:cDTS
    a skos:Concept ;
    skos:definition "Distributed Temperature Sensing (DTS) in perturbed conditions, corrected for perturbations."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "cDTS"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:cHT_FT
    a skos:Concept ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "cHT-FT"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:cLOG
    a skos:Concept ;
    skos:definition "Continuous temperature logging in a perturbed borehole, corrected for perturbations."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "cLOG"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:cRTD
    a skos:Concept ;
    skos:definition "Resistance Temperature Detector (RTD) measurement in perturbed conditions, corrected for perturbations."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "cRTD"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:other
    a skos:Concept ;
    skos:definition "Other temperature determination method (must be specified in comments)."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "Other"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

:unspecified
    a skos:Concept ;
    skos:definition "Unspecified temperature determination method."@en ;
    skos:inScheme ihfc:temperature-method ;
    skos:prefLabel "Unspecified"@en ;
    skos:topConceptOf ihfc:temperature-method ;
.

ihfc:temperature-method
    a skos:ConceptScheme ;
    dcterms:description "Methods used to measure or estimate the temperatures from which heat flow is derived."@en ;
    skos:hasTopConcept
        :BHT ,
        :BLK ,
        :BSR ,
        :CPD ,
        :DTSeq ,
        :DTSpert ,
        :EGRT ,
        :GRT ,
        :GTM ,
        :HT_FT ,
        :HT_FTpert ,
        :LOGeq ,
        :LOGpert ,
        :ODTT_PC ,
        :ODTT_TP ,
        :RTDeq ,
        :RTDpert ,
        :SUR ,
        :XEN ,
        :cBHT ,
        :cDTS ,
        :cHT_FT ,
        :cLOG ,
        :cRTD ,
        :other ,
        :unspecified ;
    skos:prefLabel "Temperature methods"@en ;
.
